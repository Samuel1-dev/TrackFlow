PORT=3000
NODE_ENV=development

# Database URL for PostgreSQL
DATABASE_URL="postgresql://taskflow_user:taskflow_pass@localhost:5432/taskflow?schema=public"

# JWT configuration
JWT_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:4200"
