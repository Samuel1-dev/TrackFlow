PORT=3000
NODE_ENV=development

# Database URL for PostgreSQL
DATABASE_URL="postgresql://taskflow_user:taskflow_pass@localhost:5432/taskflow?schema=public"

# JWT configuration
JWT_SECRET="taskflow_super_secret_jwt_key_2026_dev_mode"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="taskflow_super_secret_refresh_jwt_key_2026_dev_mode"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:4200"
